# Copy to .env and fill in real values. NEVER commit the real .env.
# .env is git-ignored; this example file is not, so it must stay empty of secrets.

# --- Supabase (Stage 3) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key is safe in the browser: it is only as powerful as the
# row-level security policies allow.
SUPABASE_PUBLISHABLE_KEY=
# The secret key BYPASSES row-level security. Backend only. Anyone holding it can
# read every order, customer email and address. Never send it to the frontend.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_DB_PASSWORD=
DATABASE_URL=

# --- Mailgun (Stage 9) ---
# Private API key. Backend only.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE=https://api.mailgun.net
MAILGUN_FROM="PhoneMatch <postmaster@YOUR-DOMAIN>"
# A Mailgun SANDBOX domain can only send to verified recipients. List them here
# so a real customer's order can never be silently dropped.
MAILGUN_ALLOWED_RECIPIENTS=
# Where new-order alerts go.
ADMIN_EMAIL=

# --- Model service ---
MODEL_SERVICE_URL=http://localhost:8000
# Shared secret so only this backend may call the model service.
MODEL_SERVICE_KEY=

# --- Frontend ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend build-time variables (frontend/.env.local, NOT here) ---
# These are NEXT_PUBLIC_ so Next.js inlines them into the browser bundle. They
# are PUBLIC by design and safe to expose: the publishable key is only as
# powerful as the row level security policies allow. The frontend NEVER gets
# SUPABASE_SECRET_KEY.
#
#   NEXT_PUBLIC_API_URL=http://localhost:4000
#   NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<the publishable key>
#
# SUPABASE_PUBLISHABLE_KEY above is the backend's copy of the same public value;
# auth.js needs it to verify sign-in tokens.
